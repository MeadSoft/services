FROM node:24-slim AS base

ENV APP_ENV="local"
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable
COPY . /workspace
WORKDIR /workspace

FROM base AS build
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
RUN pnpx nx run restaurant-catalog-api:build
RUN pnpm deploy --filter=restaurant-catalog-api --prod /app

FROM node:24-slim AS runtime

ENV APP_ENV="local"
ENV NODE_ENV="production"
ENV API_DOMAIN="_"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends nginx ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

COPY systems/restaurant-catalog/envs/dev/nginx/restaurant-catalog-api.conf /etc/nginx/templates/restaurant-catalog-api.conf
COPY --from=build /app /app

WORKDIR /app

EXPOSE 80

CMD ["bash", "-lc", "set -euo pipefail; sed \"s/API_DOMAIN/${API_DOMAIN}/g\" /etc/nginx/templates/restaurant-catalog-api.conf > /etc/nginx/conf.d/default.conf; node /app/dist/main.js & app_pid=$!; nginx -g 'daemon off;' & nginx_pid=$!; trap 'kill \"$app_pid\" \"$nginx_pid\" 2>/dev/null || true' TERM INT; wait -n \"$app_pid\" \"$nginx_pid\"; status=$?; kill \"$app_pid\" \"$nginx_pid\" 2>/dev/null || true; wait \"$app_pid\" \"$nginx_pid\" 2>/dev/null || true; exit \"$status\""]
