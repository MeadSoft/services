{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "emitDeclarationOnly": false,
        "sourceMap": true,
        "inlineSources": true,
        "inlineSourceMap": false,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts"
    ],
    "references": [
        {
            "path": "../../common/http-client-angular/tsconfig.lib.json"
        },
        {
            "path": "../../common/common/tsconfig.lib.json"
        },
        {
            "path": "../contracts/tsconfig.lib.json"
        }
    ],
    "exclude": [
        "jest.config.ts",
        "jest.config.cts",
        "src/**/*.spec.ts",
        "src/**/*.test.ts"
    ]
}