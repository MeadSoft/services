{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "emitDeclarationOnly": false,
        "sourceMap": true,
        "inlineSources": true,
        "inlineSourceMap": false,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts",
        "../../tags.client.ts",
    ],
    "references": [
        {
            "path": "../common-server/tsconfig.lib.json"
        },
        {
            "path": "../common-http-client-angular/tsconfig.lib.json"
        },
        {
            "path": "../restaurant-catalog-contracts/tsconfig.lib.json"
        }
    ],
    "exclude": [
        "jest.config.ts",
        "jest.config.cts",
        "src/**/*.spec.ts",
        "src/**/*.test.ts"
    ]
}