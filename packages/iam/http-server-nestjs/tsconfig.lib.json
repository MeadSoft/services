{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "emitDeclarationOnly": false,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts",
        "../../common/server/src/services/salting.service.ts"
    ],
    "references": [
        {
            "path": "../contracts/tsconfig.lib.json"
        },
        {
            "path": "../../common/infrastructure/tsconfig.lib.json"
        },
        {
            "path": "../../common/server/tsconfig.lib.json"
        },
        {
            "path": "../../common/common/tsconfig.lib.json"
        },
    ],
    "exclude": [
        "jest.config.ts",
        "jest.config.cts",
        "src/**/*.spec.ts",
        "src/**/*.test.ts"
    ]
}