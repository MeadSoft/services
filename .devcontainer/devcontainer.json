{
    "name": "meadsoft-services",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "remoteUser": "vscode",
    "containerUser": "vscode",
    "updateRemoteUserUID": true,
    "privileged": true,
    "containerEnv": {
        "WORKSPACE_FOLDER": "${containerWorkspaceFolder}"
    },
    "portsAttributes": {
        "5432": {
            "label": "PostgreSQL",
            "onAutoForward": "notify"
        }
    },
    "forwardPorts": [
        5432
    ],
    "mounts": [
        {
            "type": "bind",
            "source": "${localWorkspaceFolder}/.devcontainer/scripts",
            "target": "/home/vscode/scripts"
        },
        {
            "type": "bind",
            "source": "${localEnv:HOME}/.ssh",
            "target": "/home/vscode/.ssh"
        },
        {
            "type": "bind",
            "source": "/var/run/docker.sock",
            "target": "/var/run/docker.sock"
        }
    ],
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/${localWorkspaceFolderBasename}/,type=bind",
    "workspaceFolder": "/workspace/${localWorkspaceFolderBasename}",
    "postCreateCommand": "chmod 755 -R /workspace/${localWorkspaceFolderBasename}/.devcontainer/scripts; /workspace/${localWorkspaceFolderBasename}/.devcontainer/scripts/post-create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "bierner.markdown-preview-github-styles",
                "davidanson.vscode-markdownlint",
                "streetsidesoftware.code-spell-checker",
                "timonwong.shellcheck",
                "yzhang.markdown-all-in-one",
                "cyrilletuzi.angular-schematics",
                "dbaeumer.vscode-eslint",
                "stylelint.vscode-stylelint",
                "Angular.ng-template",
                "usernamehw.errorlens",
                "esbenp.prettier-vscode",
                "rvest.vs-code-prettier-eslint",
                "GitHub.copilot",
                "github.vscode-github-actions",
                "hashicorp.terraform"
            ]
        }
    }
}