    "version": "2.0.0",
    "tasks": [
        {
            "label": "Angular: serve haru-cafe-website",
            "type": "npm",
            "script": "start",
            "path": "apps/haru-cafe-website",
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "pattern": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": {
                        "regexp": "(.*?)"
                    },
                    "endsPattern": {
                        "regexp": "bundle generation complete"
                    }
                }
            }
        },
        {
            "label": "Angular: build haru-cafe-website (SSR development)",
            "type": "npm",
            "script": "build:development",
            "path": "apps/haru-cafe-website",
            "problemMatcher": [
                "$tsc"
            ]
        }
    ]
}