{
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "attach",
            "name": "Attach to Node",
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/apps/haru-cafe-website/dist/**/*.mjs",
                "${workspaceFolder}/apps/haru-cafe-website/dist/**/*.js",
                "${workspaceFolder}/packages/*/dist/**/*.map"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/apps/haru-cafe-website/**",
                "!**/node_modules/**"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Node: Debug Restaurant Catalog API",
            "type": "node",
            "request": "launch",
            "env": {
                "APP_ENV": "local"
            },
            "runtimeExecutable": "nx",
            "runtimeArgs": [
                "run",
                "restaurant-catalog-http-api:start:debug"
            ],
            "console": "integratedTerminal",
            "sourceMaps": true,
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outFiles": [
                "${workspaceFolder}/apps/restaurant-catalog-http-api/dist/**/*.js",
                "${workspaceFolder}/packages/*/dist/**/*.js",
                "${workspaceFolder}/packages/*/dist/**/*.map"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ]
        },
        {
            "name": "Node: Debug Script",
            "type": "node",
            "request": "launch",
            "env": {
                "APP_ENV": "local"
            },
            "runtimeExecutable": "nx",
            "runtimeArgs": [
                "run",
                "restaurant-catalog-http-api:db-seed-backup"
            ],
            "port": 9229,
            "console": "integratedTerminal",
            "sourceMaps": true,
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outFiles": [
                "${workspaceFolder}/apps/restaurant-catalog-http-api/dist/**/*.js",
                "${workspaceFolder}/packages/*/dist/**/*.js",
                "${workspaceFolder}/packages/*/dist/**/*.map"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ]
        },
        {
            "name": "Angular: haru-cafe-website SSR",
            "type": "node",
            "request": "launch",
            "env": {
                "APP_ENV": "local"
            },
            "runtimeExecutable": "nx",
            "runtimeArgs": [
                "run",
                "haru-cafe-website:serve:ssr:debug"
            ],
            "console": "integratedTerminal",
            "sourceMaps": true,
            "smartStep": true,
            "outFiles": [
                "${workspaceFolder}/apps/haru-cafe-website/dist/haru-cafe/server/**/*.mjs",
                "${workspaceFolder}/apps/haru-cafe-website/dist/haru-cafe/server**/*.js",
                "${workspaceFolder}/packages/*/dist/**/*.map"
            ],
            "resolveSourceMapLocations": [
                "!**/node_modules/**"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
        },
        {
            "name": "Angular: haru-cafe-website (Microsoft Edge)",
            "type": "msedge",
            "request": "launch",
            "preLaunchTask": "Angular: serve haru-cafe-website",
            "url": "http://localhost:4200/",
            "webRoot": "${workspaceFolder}"
        }
    ],
}